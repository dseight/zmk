#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>


/* Enable ONLY ONE of the &encoder_1 nodes. They are wired to the same pins.*/
&encoder_1_top_row {
    status = "okay";
};

/* Add any encoder(s) you have enabled to the sensors node, separated by spaces. */
&sensors {
    sensors = <&encoder_1_top_row>;
};

/ {
    macros {
        tmux_window_prev: tmux_window_prev {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp P>
                ;
        };

        tmux_window_next: tmux_window_next {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_tap &kp N>
                ;
        };
    };

    behaviors {
        tmux_switcher: tmux_switcher {
            compatible = "zmk,behavior-sensor-rotate";
            label = "TMUX_SWITCHER";
            #sensor-binding-cells = <0>;
            bindings = <&tmux_window_prev>, <&tmux_window_next>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                            &kp KP_NUM  &kp KP_SLASH    &kp KP_ASTERISK
                &kp KP_N7   &kp KP_N8   &kp KP_N9       &kp KP_MINUS
                &kp KP_N4   &kp KP_N5   &kp KP_N6       &kp KP_PLUS
                &kp KP_N1   &kp KP_N2   &kp KP_N3       &kp KP_ENTER
                &kp BSPC    &kp KP_N0   &kp KP_DOT      &kp PRINTSCREEN
            >;

            sensor-bindings = <&tmux_switcher>;
        };
    };
};
